<?xml version="1.0" encoding="utf-16"?>
<form Top="10" Left="10" Width="750" Height="600" AutoManaged="False" DefaultButton="1" FormType="-1" BorderStyle="4" Color="0" Pane="0" Mode="3" Title="Contract Management" Visible="False">
  <datasources>
    <DataTables>
      <DataTable Uid="DT_HEAD">
        <Columns>
          <Column Uid="Code" Type="0" MaxLength="50"/>
          <Column Uid="Customer" Type="0" MaxLength="50"/>
          <Column Uid="CustName" Type="0" MaxLength="100"/>
          <Column Uid="Descript" Type="0" MaxLength="254"/>
          <Column Uid="StartDate" Type="1"/>
          <Column Uid="EndDate" Type="1"/>
          <Column Uid="Value" Type="2"/>
          <Column Uid="Status" Type="0" MaxLength="1"/>
          <Column Uid="Retention" Type="2"/>
        </Columns>
      </DataTable>
      <DataTable Uid="DT_LINES">
        <Columns>
          <Column Uid="LineNum" Type="0" MaxLength="10"/>
          <Column Uid="ItemCode" Type="0" MaxLength="50"/>
          <Column Uid="Descript" Type="0" MaxLength="254"/>
          <Column Uid="Quantity" Type="2"/>
          <Column Uid="Price" Type="2"/>
          <Column Uid="Total" Type="2"/>
        </Columns>
      </DataTable>
    </DataTables>
  </datasources>
  <items>
    <!-- Title -->
    <item Type="8" Top="5" Left="10" Width="730" Height="14" UniqueID="stTitle" Visible="True" Enabled="True" FromPane="0" ToPane="0">
      <specific Caption="Contract - Header" type="8"/>
    </item>

    <!-- Folder Tab Control -->
    <item Type="113" Top="25" Left="5" Width="740" Height="520" UniqueID="fldMain" Visible="True" Enabled="True" FromPane="0" ToPane="0">
      <specific type="113" Caption="" AffectsFormMode="1">
        <action type="add">
          <folder UniqueID="fld1" Caption="General" Pane="1" type="113"/>
        </action>
        <action type="add">
          <folder UniqueID="fld2" Caption="Lines" Pane="2" type="113"/>
        </action>
      </specific>
    </item>

    <!-- PANE 1: GENERAL TAB -->

    <!-- Row 1: Contract Code -->
    <item Type="8" Top="50" Left="10" Width="100" Height="14" UniqueID="stCode" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Code:" type="8"/>
    </item>
    <item Type="16" Top="50" Left="120" Width="150" Height="14" UniqueID="txtCode" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="Code"/>
      </specific>
    </item>

    <!-- Row 2: Customer -->
    <item Type="8" Top="70" Left="10" Width="100" Height="14" UniqueID="stCust" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Customer:" type="8"/>
    </item>
    <item Type="16" Top="70" Left="120" Width="100" Height="14" UniqueID="txtCust" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="Customer"/>
      </specific>
    </item>
    <item Type="4" Top="70" Left="225" Width="20" Height="14" UniqueID="btnCust" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="..." type="4"/>
    </item>
    <item Type="16" Top="70" Left="250" Width="250" Height="14" UniqueID="txtCName" Visible="True" Enabled="False" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="CustName"/>
      </specific>
    </item>

    <!-- Row 3: Description -->
    <item Type="8" Top="90" Left="10" Width="100" Height="14" UniqueID="stDesc" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Desc:" type="8"/>
    </item>
    <item Type="16" Top="90" Left="120" Width="600" Height="14" UniqueID="txtDesc" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="Descript"/>
      </specific>
    </item>

    <!-- Row 4: Start Date -->
    <item Type="8" Top="110" Left="10" Width="100" Height="14" UniqueID="stStart" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Start:" type="8"/>
    </item>
    <item Type="16" Top="110" Left="120" Width="100" Height="14" UniqueID="txtStart" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="StartDate"/>
      </specific>
    </item>

    <!-- Row 5: End Date -->
    <item Type="8" Top="110" Left="250" Width="100" Height="14" UniqueID="stEnd" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="End:" type="8"/>
    </item>
    <item Type="16" Top="110" Left="360" Width="100" Height="14" UniqueID="txtEnd" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="EndDate"/>
      </specific>
    </item>

    <!-- Row 6: Value -->
    <item Type="8" Top="130" Left="10" Width="100" Height="14" UniqueID="stValue" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Value:" type="8"/>
    </item>
    <item Type="16" Top="130" Left="120" Width="150" Height="14" UniqueID="txtValue" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="Value"/>
      </specific>
    </item>

    <!-- Row 7: Status -->
    <item Type="8" Top="150" Left="10" Width="100" Height="14" UniqueID="stStatus" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Status:" type="8"/>
    </item>
    <item Type="121" Top="150" Left="120" Width="150" Height="14" UniqueID="cmbStat" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="121">
        <databind DataBound="1" Table="DT_HEAD" Alias="Status"/>
        <ValidValues>
          <action type="add">
            <ValidValue Value="D" Description="Draft"/>
          </action>
          <action type="add">
            <ValidValue Value="A" Description="Active"/>
          </action>
          <action type="add">
            <ValidValue Value="C" Description="Closed"/>
          </action>
          <action type="add">
            <ValidValue Value="X" Description="Cancelled"/>
          </action>
        </ValidValues>
      </specific>
    </item>

    <!-- Row 8: Retention % -->
    <item Type="8" Top="170" Left="10" Width="100" Height="14" UniqueID="stRet" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific Caption="Retent%:" type="8"/>
    </item>
    <item Type="16" Top="170" Left="120" Width="100" Height="14" UniqueID="txtRet" Visible="True" Enabled="True" FromPane="1" ToPane="1">
      <specific type="16">
        <databind DataBound="1" Table="DT_HEAD" Alias="Retention"/>
      </specific>
    </item>

    <!-- PANE 2: LINES TAB -->

    <!-- Lines Grid -->
    <item Type="128" Top="50" Left="10" Width="720" Height="440" UniqueID="grdLines" Visible="True" Enabled="True" FromPane="2" ToPane="2">
      <specific SelectionMode="0" Layout="0" type="128">
        <databind DataBound="1" Table="DT_LINES"/>
        <Columns>
          <action type="add">
            <Column Type="16" UniqueID="clNum" Title="#" Editable="False" Width="30" Visible="True" ValOn="Y" ValOff="N">
              <databind DataBound="1" Table="DT_LINES" Alias="LineNum"/>
            </Column>
          </action>
          <action type="add">
            <Column Type="16" UniqueID="clItem" Title="Item Code" Editable="True" Width="100" Visible="True">
              <databind DataBound="1" Table="DT_LINES" Alias="ItemCode"/>
            </Column>
          </action>
          <action type="add">
            <Column Type="16" UniqueID="clDesc" Title="Description" Editable="True" Width="250" Visible="True">
              <databind DataBound="1" Table="DT_LINES" Alias="Descript"/>
            </Column>
          </action>
          <action type="add">
            <Column Type="16" UniqueID="clQty" Title="Quantity" Editable="True" Width="80" RightJust="True" Visible="True">
              <databind DataBound="1" Table="DT_LINES" Alias="Quantity"/>
            </Column>
          </action>
          <action type="add">
            <Column Type="16" UniqueID="clPrice" Title="Price" Editable="True" Width="100" RightJust="True" Visible="True">
              <databind DataBound="1" Table="DT_LINES" Alias="Price"/>
            </Column>
          </action>
          <action type="add">
            <Column Type="16" UniqueID="clTotal" Title="Total" Editable="False" Width="120" RightJust="True" Visible="True">
              <databind DataBound="1" Table="DT_LINES" Alias="Total"/>
            </Column>
          </action>
        </Columns>
      </specific>
    </item>

    <!-- Buttons at bottom -->
    <item Type="4" Top="555" Left="10" Width="65" Height="19" UniqueID="1" Visible="True" Enabled="True" FromPane="0" ToPane="0">
      <specific Caption="OK" type="4"/>
    </item>
    <item Type="4" Top="555" Left="80" Width="65" Height="19" UniqueID="2" Visible="True" Enabled="True" FromPane="0" ToPane="0">
      <specific Caption="Cancel" type="4"/>
    </item>
    <item Type="4" Top="555" Left="150" Width="65" Height="19" UniqueID="btnFind" Visible="True" Enabled="True" FromPane="0" ToPane="0">
      <specific Caption="Find" type="4"/>
    </item>

  </items>
</form>
