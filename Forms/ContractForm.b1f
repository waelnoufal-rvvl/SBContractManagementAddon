          <item uid="cmbStat" type="121" left="120" tab_order="70" width="150" top="150" height="14" visible="1" enabled="1" from_pane="1" to_pane="1" disp_desc="0" right_just="0" description="" linkto="" forecolor="-1" backcolor="-1" text_style="0" font_size="-1">
            <specific type="121">
              <databind databound="1" table="DT_HEAD" alias="Status"/>
              <ValidValues>
                <action type="add">
                  <ValidValue value="D" description="Draft"/>
                </action>
                <action type="add">
                  <ValidValue value="A" description="Active"/>
                </action>
                <action type="add">
                  <ValidValue value="C" description="Closed"/>
