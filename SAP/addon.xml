<AddOn>
    <!-- General Information -->
    <General>
        <Name>Contract Management</Name>
        <Version>1.0.0</Version>
        <Description>Comprehensive contract management solution for SAP Business One featuring revenue recognition compliance (ASC 606/IFRS 15) and multi-currency support</Description>
        <Vendor>Your Company Name</Vendor>
        <VendorURL>https://yourcompany.com</VendorURL>
        <SupportEmail>support@yourcompany.com</SupportEmail>
        <SupportPhone>+1-XXX-XXX-XXXX</SupportPhone>
        <DocumentationURL>https://yourcompany.com/docs/contract-management</DocumentationURL>
        <ReleaseDate>2025-11-05</ReleaseDate>
        <Category>Financial Management</Category>
        <SubCategory>Contract Management</SubCategory>
    </General>

    <!-- System Requirements -->
    <Requirements>
        <SAPB1Version>9.3</SAPB1Version>
        <MinimumPatchLevel>00</MinimumPatchLevel>
        <DotNetVersion>4.7.2</DotNetVersion>
        <OperatingSystem>
            <Windows>
                <MinVersion>6.1</MinVersion> <!-- Windows 7 SP1 / Server 2008 R2 SP1 -->
                <SupportedVersions>
                    <Version>Windows 10</Version>
                    <Version>Windows 11</Version>
                    <Version>Windows Server 2012</Version>
                    <Version>Windows Server 2016</Version>
                    <Version>Windows Server 2019</Version>
                    <Version>Windows Server 2022</Version>
                </SupportedVersions>
            </Windows>
        </OperatingSystem>
        <DatabaseTypes>
            <Type>MSSQL</Type>
            <Type>HANA</Type>
        </DatabaseTypes>
        <DatabaseVersions>
            <MSSQL>2014</MSSQL>
            <HANA>2.0 SPS 03</HANA>
        </DatabaseVersions>
    </Requirements>

    <!-- Files Included in Add-on -->
    <Files>
        <File>
            <Name>ContractManagementAddon.exe</Name>
            <Type>Executable</Type>
            <Version>1.0.0.0</Version>
            <Size>2048</Size> <!-- KB -->
            <Description>Main add-on executable</Description>
        </File>
        <File>
            <Name>ContractManagementAddon.exe.config</Name>
            <Type>Configuration</Type>
            <Version>1.0.0.0</Version>
            <Description>Application configuration file</Description>
        </File>
        <File>
            <Name>Interop.SAPbobsCOM.dll</Name>
            <Type>Library</Type>
            <Description>SAP Business One DI API interop</Description>
        </File>
        <File>
            <Name>Interop.SAPbouiCOM.dll</Name>
            <Type>Library</Type>
            <Description>SAP Business One UI API interop</Description>
        </File>
    </Files>

    <!-- Database Objects -->
    <Database>
        <!-- Migration Scripts -->
        <Scripts>
            <Script Type="SQLServer" Order="1">
                <Name>01_Add_PerformObligCode_Field_SQLServer.sql</Name>
                <Description>Adds PerformanceObligationCode field to CM_DEFERRED_REV table</Description>
                <RunOn>FirstInstall</RunOn>
                <Required>true</Required>
            </Script>
            <Script Type="HANA" Order="1">
                <Name>01_Add_PerformObligCode_Field_HANA.sql</Name>
                <Description>Adds PerformanceObligationCode field to CM_DEFERRED_REV table</Description>
                <RunOn>FirstInstall</RunOn>
                <Required>true</Required>
            </Script>
        </Scripts>

        <!-- User Defined Objects (UDOs) -->
        <UserDefinedObjects>
            <UDO>
                <Name>CM_CURRENCY</Name>
                <TableName>@CM_CURRENCY</TableName>
                <Description>Currency master data (ISO 4217 compliant)</Description>
                <ObjectType>MasterData</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>true</CanDelete>
                <CanCancel>false</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_EXCHANGE_RATE</Name>
                <TableName>@CM_EXCHANGE_RATE</TableName>
                <Description>Exchange rates with historical tracking</Description>
                <ObjectType>MasterData</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>true</CanDelete>
                <CanCancel>false</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_PERFORMANCE_OBLIGATION</Name>
                <TableName>@CM_PERFORMANCE_OBLIGATION</TableName>
                <Description>Performance obligations (ASC 606 Step 2)</Description>
                <ObjectType>MasterData</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>false</CanDelete>
                <CanCancel>true</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_REVENUE_SCHEDULE</Name>
                <TableName>@CM_REVENUE_SCHEDULE</TableName>
                <Description>Revenue recognition schedules</Description>
                <ObjectType>Document</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>false</CanDelete>
                <CanCancel>true</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_DEFERRED_REV</Name>
                <TableName>@CM_DEFERRED_REV</TableName>
                <Description>Deferred revenue tracking (contract liabilities)</Description>
                <ObjectType>Document</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>false</CanDelete>
                <CanCancel>true</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_CONTRACT_ASSET</Name>
                <TableName>@CM_CONTRACT_ASSET</TableName>
                <Description>Contract assets (unbilled revenue)</Description>
                <ObjectType>Document</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>false</CanDelete>
                <CanCancel>true</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_CONTRACT_BACKLOG</Name>
                <TableName>@CM_CONTRACT_BACKLOG</TableName>
                <Description>Contract backlog and forecasting</Description>
                <ObjectType>MasterData</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>true</CanDelete>
                <CanCancel>false</CanCancel>
                <CanLog>true</CanLog>
            </UDO>
            <UDO>
                <Name>CM_REV_RECOGNITION_LOG</Name>
                <TableName>@CM_REV_RECOGNITION_LOG</TableName>
                <Description>Revenue recognition audit trail</Description>
                <ObjectType>NoObject</ObjectType>
                <CanFind>true</CanFind>
                <CanDelete>false</CanDelete>
                <CanCancel>false</CanCancel>
                <CanLog>false</CanLog>
            </UDO>
        </UserDefinedObjects>

        <!-- User Defined Tables (UDTs) - If separate from UDOs -->
        <UserDefinedTables>
            <UDT>
                <Name>CM_CONVERSION_LOG</Name>
                <TableName>@CM_CONVERSION_LOG</TableName>
                <Description>Currency conversion audit log</Description>
                <TableType>NoObject</TableType>
            </UDT>
        </UserDefinedTables>
    </Database>

