        </Forms>
    </UserInterface>

    <!-- Features -->
    <Features>
        <Feature>
            <Name>Revenue Recognition</Name>
            <Description>ASC 606 / IFRS 15 compliant revenue recognition</Description>
            <Enabled>true</Enabled>
            <Category>Financial Accounting</Category>
        </Feature>
        <Feature>
            <Name>Multi-Currency Support</Name>
            <Description>ISO 4217 compliant multi-currency with exchange rate management</Description>
            <Enabled>true</Enabled>
            <Category>Financial Management</Category>
        </Feature>
        <Feature>
            <Name>Contract Management</Name>
            <Description>Comprehensive contract lifecycle management</Description>
            <Enabled>true</Enabled>
            <Category>Project Management</Category>
        </Feature>
        <Feature>
            <Name>IPC Processing</Name>
            <Description>Interim Payment Certificate creation and processing</Description>
            <Enabled>true</Enabled>
            <Category>Billing</Category>
        </Feature>
        <Feature>
            <Name>Change Order Management</Name>
            <Description>Contract change order processing and approval</Description>
            <Enabled>true</Enabled>
            <Category>Contract Management</Category>
        </Feature>
        <Feature>
            <Name>Performance Obligations</Name>
            <Description>ASC 606 Step 2 - Identify performance obligations</Description>
            <Enabled>true</Enabled>
            <Category>Revenue Recognition</Category>
        </Feature>
        <Feature>
            <Name>Deferred Revenue</Name>
            <Description>Contract liability tracking and management</Description>
            <Enabled>true</Enabled>
            <Category>Revenue Recognition</Category>
        </Feature>
        <Feature>
            <Name>Contract Assets</Name>
            <Description>Unbilled revenue tracking</Description>
            <Enabled>true</Enabled>
            <Category>Revenue Recognition</Category>
        </Feature>
    </Features>

    <!-- Authorizations -->
    <Authorizations>
        <Authorization>
            <Name>Full Access</Name>
            <Description>Full access to all Contract Management features</Description>
            <Code>CM_FULL</Code>
        </Authorization>
        <Authorization>
            <Name>Contract Manager</Name>
            <Description>Create and manage contracts, IPCs, and change orders</Description>
            <Code>CM_MANAGER</Code>
        </Authorization>
        <Authorization>
            <Name>Finance Manager</Name>
            <Description>Access to revenue recognition and financial features</Description>
            <Code>CM_FINANCE</Code>
        </Authorization>
        <Authorization>
            <Name>Billing Clerk</Name>
            <Description>Create and manage IPCs only</Description>
            <Code>CM_BILLING</Code>
        </Authorization>
        <Authorization>
            <Name>Read Only</Name>
            <Description>View-only access to all features</Description>
            <Code>CM_READONLY</Code>
        </Authorization>
    </Authorizations>

    <!-- Configuration -->
    <Configuration>
        <Settings>
            <Setting>
                <Name>BaseCurrency</Name>
                <Description>Base currency for the company</Description>
                <Type>String</Type>
                <DefaultValue>USD</DefaultValue>
                <Required>true</Required>
            </Setting>
            <Setting>
                <Name>DefaultProgressMethod</Name>
                <Description>Default revenue recognition progress method</Description>
                <Type>String</Type>
                <DefaultValue>Cost-to-Cost</DefaultValue>
                <AllowedValues>Cost-to-Cost,Units,Milestone,Time-Based</AllowedValues>
            </Setting>
            <Setting>
                <Name>AutoRecognizeRevenue</Name>
                <Description>Automatically recognize revenue on IPC approval</Description>
                <Type>Boolean</Type>
                <DefaultValue>true</DefaultValue>
            </Setting>
            <Setting>
                <Name>RequireApprovalAbove</Name>
                <Description>Require manual approval for revenue above this amount</Description>
                <Type>Decimal</Type>
                <DefaultValue>100000</DefaultValue>
            </Setting>
            <Setting>
                <Name>LogLevel</Name>
                <Description>Application logging level</Description>
                <Type>String</Type>
                <DefaultValue>Info</DefaultValue>
                <AllowedValues>Debug,Info,Warning,Error</AllowedValues>
            </Setting>
        </Settings>
    </Configuration>

    <!-- Dependencies -->
    <Dependencies>
        <Dependency>
            <Name>SAP Business One DI API</Name>
            <Version>9.3</Version>
            <Required>true</Required>
            <Type>API</Type>
        </Dependency>
        <Dependency>
            <Name>SAP Business One UI API</Name>
            <Version>9.3</Version>
            <Required>true</Required>
            <Type>API</Type>
        </Dependency>
        <Dependency>
            <Name>.NET Framework</Name>
            <Version>4.7.2</Version>
            <Required>true</Required>
            <Type>Runtime</Type>
        </Dependency>
    </Dependencies>

    <!-- Installation -->
    <Installation>
        <Steps>
            <Step Order="1">
                <Name>Prerequisites Check</Name>
                <Description>Verify SAP B1 and .NET Framework versions</Description>
                <Type>Validation</Type>
            </Step>
            <Step Order="2">
                <Name>Copy Files</Name>
                <Description>Copy add-on files to installation directory</Description>
                <Type>FileCopy</Type>
            </Step>
            <Step Order="3">
                <Name>Database Migration</Name>
                <Description>Run database migration scripts</Description>
                <Type>DatabaseScript</Type>
                <Manual>true</Manual>
            </Step>
            <Step Order="4">
                <Name>Create UDOs</Name>
                <Description>Create User Defined Objects in SAP B1</Description>
                <Type>UDOCreation</Type>
            </Step>
            <Step Order="5">
                <Name>Register Add-on</Name>
                <Description>Register add-on with SAP B1</Description>
                <Type>Registration</Type>
            </Step>
            <Step Order="6">
                <Name>Initialize Data</Name>
                <Description>Load currency seed data (optional)</Description>
                <Type>DataInitialization</Type>
                <Optional>true</Optional>
            </Step>
        </Steps>
    </Installation>

